<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.Rectangle?>

<StackPane prefHeight="700.0" prefWidth="1000.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.MenuPageController">

    <!-- Fond de secours -->
    <VBox styleClass="main-background" />

    <!-- Image de fond -->
    <ImageView fitHeight="700.0" fitWidth="1000.0" preserveRatio="false">
        <image>
            <Image url="@image/fond.jpg" />
        </image>
    </ImageView>

    <!-- Dark blue overlay -->
    <Rectangle width="1000.0" height="700.0" fill="rgba(10, 35, 66, 0.7)"/>

    <!-- Conteneur principal -->
    <BorderPane fx:id="rootPane" styleClass="transparent-container">

        <!-- En-tête -->
        <top>
            <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="header-transparent">
                <padding>
                    <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
                </padding>
                <ImageView fx:id="logoImage" fitHeight="80.0" fitWidth="80.0" preserveRatio="true">
                    <image>
                        <Image url="@icons/travelpro_logo.png" />
                    </image>
                </ImageView>

                <VBox alignment="CENTER_LEFT" styleClass="title-container">
                    <Text styleClass="app-title" text="WELCOME" />
                    <Text styleClass="app-subtitle" text="Elevate your busniss travel with us!" />
                </VBox>

                <HBox alignment="CENTER_RIGHT" spacing="15" HBox.hgrow="ALWAYS">
                    <Button styleClass="nav-button" text="Home">
                        <graphic>
                            <ImageView fitHeight="16.0" fitWidth="16.0" preserveRatio="true">
                                <image>
                                    <Image url="@icons/home.png" />
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>

                    <Button fx:id="profileBtn" styleClass="nav-button" text="Profil" onAction="#handleProfile">
                        <graphic>
                            <ImageView fitHeight="16.0" fitWidth="16.0" preserveRatio="true">
                                <image>
                                    <Image url="@icons/face-id-icon.png" />
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>

                    <Button styleClass="nav-button" text="Paramètres">
                        <graphic>
                            <ImageView fitHeight="16.0" fitWidth="16.0" preserveRatio="true">
                                <image>
                                    <Image url="@icons/settings.png" />
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                    <Button fx:id="dashboardButton" text="Dashboard" onAction="#handleDashboard"/>
               <Button fx:id="logoutButton" styleClass="nav-button" text="Logout" onAction="#handleLogout">
                   <graphic>
                       <ImageView fitHeight="16.0" fitWidth="16.0" preserveRatio="true">
                           <image>
                               <Image url="@icons/logout.png" />
                           </image>
                       </ImageView>
                   </graphic>
               </Button>
                </HBox>
            </HBox>
        </top>

        <center>
            <VBox fx:id="contentArea" spacing="20.0" styleClass="content-area-transparent">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                </padding>

                <!-- Barre supérieure -->
                <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="section-header-transparent">
                    <Text styleClass="section-title-light" text="" />
                    <Pane HBox.hgrow="ALWAYS" />
                </HBox>



                <HBox alignment="CENTER" spacing="10" styleClass="pagination-container-transparent">
                    <!--Label fx:id="welcomeLabel" layoutX="50" layoutY="30" text="Welcome!" />
                    Label fx:id="userRoleLabel" layoutX="50" layoutY="60" text="Role:" />
                    <Label fx:id="lastLoginLabel" layoutX="50" layoutY="90" text="Session start time" />
                          -->
                </HBox>

            </VBox>
        </center>
        <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="pagination-container-transparent">
            <padding>
                <Insets left="20.0" bottom="15.0"/>
            </padding>
            <Label fx:id="welcomeLabel" text="Welcome!" />
        </HBox>
    </bottom>
    </BorderPane>
</StackPane>