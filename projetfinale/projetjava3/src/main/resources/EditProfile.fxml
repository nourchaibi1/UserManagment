<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<StackPane prefHeight="800.0" prefWidth="1200.0"
           xmlns="http://javafx.com/javafx/23.0.1"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controllers.DashboardCont"
           stylesheets="@style.css">

    <!-- Background with solid color as fallback -->
    <VBox styleClass="main-background"/>

    <!-- Main container -->
    <BorderPane styleClass="transparent-container">
        <!-- Header -->
        <top>
            <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="header-transparent">
                <padding>
                    <Insets top="15.0" right="20.0" bottom="15.0" left="20.0"/>
                </padding>
                <Text text="Edit Profile" styleClass="app-title"/>
            </HBox>
        </top>

        <!-- Main Content -->
        <center>
            <VBox spacing="20" alignment="CENTER" styleClass="content-area-transparent">
                <padding>
                    <Insets top="20.0" right="40.0" bottom="20.0" left="40.0"/>
                </padding>

                <!-- Edit Form -->
                <GridPane hgap="15" vgap="15" styleClass="edit-form-transparent">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" />
                        <ColumnConstraints percentWidth="50" />
                    </columnConstraints>

                    <!-- Form Fields -->
                    <TextField fx:id="nomField" promptText="Nom" styleClass="form-field-transparent"
                             GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="prenomField" promptText="Prénom" styleClass="form-field-transparent"
                             GridPane.columnIndex="1" GridPane.rowIndex="0" />
                    <TextField fx:id="emailField" promptText="Email" styleClass="form-field-transparent"
                             GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <TextField fx:id="telephoneField" promptText="Téléphone" styleClass="form-field-transparent"
                             GridPane.columnIndex="1" GridPane.rowIndex="1" />
                    <TextField fx:id="dateNaissanceField" promptText="Date de Naissance (YYYY-MM-DD)" styleClass="form-field-transparent"
                             GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <TextField fx:id="statutField" promptText="Statut" styleClass="form-field-transparent"
                             GridPane.columnIndex="1" GridPane.rowIndex="2" />
                    <TextField fx:id="roleField" promptText="Role" styleClass="form-field-transparent"
                             GridPane.columnIndex="0" GridPane.rowIndex="3" />

                    <!-- Buttons -->
                    <HBox spacing="10" alignment="CENTER_RIGHT" GridPane.columnSpan="2" GridPane.rowIndex="4">
                        <Button text="Save Changes" onAction="#handleSaveChanges" styleClass="confirm-button">
                            <graphic>
                                <ImageView fitHeight="16.0" fitWidth="16.0" preserveRatio="true">
                                    <image>
                                        <Image url="@icons/save.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button text="Cancel" onAction="#handleCancelEdit" styleClass="cancel-button">
                            <graphic>
                                <ImageView fitHeight="16.0" fitWidth="16.0" preserveRatio="true">
                                    <image>
                                        <Image url="@icons/edit.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </HBox>
                </GridPane>
            </VBox>
        </center>
        <bottom>
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="pagination-container-transparent">
                <padding>
                    <Insets left="20.0" bottom="15.0"/>
                </padding>
                <Label fx:id="welcomeLabel" text="Welcome!" />
            </HBox>
        </bottom>

    </BorderPane>
</StackPane> 