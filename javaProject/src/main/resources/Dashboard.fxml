<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>
<?import models.User?>
<?import javafx.scene.control.TableColumn?>
        <?import javafx.scene.control.TableView?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.util.Callback?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<StackPane prefHeight="900.0" prefWidth="1200.0"
           xmlns="http://javafx.com/javafx/23.0.1"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controllers.DashboardCont"
           stylesheets="@style.css">

    <!-- Background with solid color as fallback -->
    <VBox styleClass="main-background" VBox.vgrow="ALWAYS"/>

    <!-- Background image -->
    <ImageView fitWidth="1200.0" fitHeight="900.0" preserveRatio="false">
        <image>
            <Image url="@/image/fond.jpg"/>
        </image>
    </ImageView>

    <!-- Dark blue overlay -->
    <Rectangle width="1200.0" height="900.0" fill="rgba(10, 35, 66, 0.7)"/>

    <!-- Main container with transparent background -->
    <BorderPane styleClass="transparent-container" >
        <!-- Header -->
        <top>
            <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="header-transparentt">
                <padding>
                    <Insets top="15.0" right="20.0" bottom="15.0" left="20.0"/>
                </padding>

                <!-- Logo -->
                <StackPane styleClass="logo-container">
                    <ImageView fitHeight="80.0" fitWidth="80.0" preserveRatio="true">
                        <image>
                            <Image url="@icons/travelpro_logo.png"/>
                        </image>
                    </ImageView>
                </StackPane>

                <!-- Title -->
                <VBox alignment="CENTER_LEFT" styleClass="title-container">
                    <Text text="USER DASHBOARD" styleClass="app-title"/>
                    <Text text="MANAGE YOUR USERS EFFICIENTLY" styleClass="app-subtitle"/>
                </VBox>

                <HBox HBox.hgrow="ALWAYS" alignment="CENTER_RIGHT" spacing="15">
                    <!-- Navigation buttons -->
                    <Button text="Home" styleClass="nav-button" onAction="#handleHomeNavigation">
                        <graphic>
                            <ImageView fitHeight="16.0" fitWidth="16.0" preserveRatio="true">
                                <image>
                                    <Image url="@icons/home.png"/>
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                    <Button text="Settings" styleClass="nav-button">
                        <graphic>
                            <ImageView fitHeight="16.0" fitWidth="16.0" preserveRatio="true">
                                <image>
                                    <Image url="@icons/settings.png"/>
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                </HBox>
            </HBox>
        </top>

        <!-- Main Content -->
        <center>
            <VBox spacing="10.0" styleClass="content-area-transparent" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="10.0" right="20.0" bottom="10.0" left="20.0"/>
                </padding>

                <!-- Search Section -->
                <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="section-header-transparent">
                    <Text text="User Management" styleClass="section-title-light"/>
                    <Pane HBox.hgrow="ALWAYS"/>

                    <!-- Search box -->
                    <HBox alignment="CENTER" styleClass="search-box-transparent">
                        <ImageView fitHeight="16.0" fitWidth="16.0" preserveRatio="true">
                            <image>
                                <Image url="@icons/serach.png"/>
                            </image>
                        </ImageView>
                        <TextField fx:id="searchEmailField" promptText="Enter Email to Search" styleClass="search-field-transparent"/>
                    </HBox>

                    <!-- Search button -->
                    <Button text="Search" onAction="#handleSearchByEmail" styleClass="action-button">
                        <graphic>
                            <ImageView fitHeight="16.0" fitWidth="16.0" preserveRatio="true">
                                <image>
                                    <Image url="@icons/serach.png"/>
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                </HBox>

                <!-- User Table -->
                <TableView fx:id="userTableView"  styleClass="transparent-table" VBox.vgrow="ALWAYS" prefHeight="700.0" prefWidth="300"
                    style="-fx-background-color: rgba(10, 35, 66, 0.4); -fx-table-cell-border-color: transparent;">
                    <columns>
                        <TableColumn fx:id="nomCol" text="Nom" prefWidth="60" styleClass="table-column"
                            style="-fx-background-color: rgba(10, 35, 66, 0.5); -fx-text-fill: white;">
                            <cellValueFactory>
                                <PropertyValueFactory property="nom" />
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="prenomCol" text="Prénom" prefWidth="60" styleClass="table-column"
                            style="-fx-background-color: rgba(10, 35, 66, 0.5); -fx-text-fill: white;">
                            <cellValueFactory>
                                <PropertyValueFactory property="prenom" />
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="emailCol" text="Email" prefWidth="150" styleClass="table-column"
                            style="-fx-background-color: rgba(10, 35, 66, 0.5); -fx-text-fill: white;">
                            <cellValueFactory>
                                <PropertyValueFactory property="email" />
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="telephoneCol" text="Téléphone" prefWidth="100" styleClass="table-column"
                            style="-fx-background-color: rgba(10, 35, 66, 0.5); -fx-text-fill: white;">
                            <cellValueFactory>
                                <PropertyValueFactory property="numerotelephone" />
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="dateNaissanceCol" text="Date de Naissance" prefWidth="200" styleClass="table-column"
                            style="-fx-background-color: rgba(10, 35, 66, 0.5); -fx-text-fill: white;">
                            <cellValueFactory>
                                <PropertyValueFactory property="datedenaissance" />
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="statutCol" text="Statut" prefWidth="90" styleClass="table-column"
                            style="-fx-background-color: rgba(10, 35, 66, 0.5); -fx-text-fill: white;">
                            <cellValueFactory>
                                <PropertyValueFactory property="statut" />
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="roleCol" text="Role" prefWidth="60" styleClass="table-column"
                            style="-fx-background-color: rgba(10, 35, 66, 0.5); -fx-text-fill: white;">
                            <cellValueFactory>
                                <PropertyValueFactory property="role" />
                            </cellValueFactory>
                        </TableColumn>

                        <TableColumn fx:id="banUnbanCol" text="Ban/Unban" prefWidth="150" styleClass="table-column"
                                     style="-fx-background-color: rgba(10, 35, 66, 0.5); -fx-text-fill: white;">
                            <cellValueFactory>
                                <PropertyValueFactory property="banStatus"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colRegistrationDate" text="Registration Date" styleClass="table-column"
                                     style="-fx-background-color: rgba(10, 35, 66, 0.5); -fx-text-fill: white;"/>
                        <TableColumn fx:id="modifierCol" text="Modifier" prefWidth="100" styleClass="action-column"
                                     style="-fx-background-color: rgba(10, 35, 66, 0.5); -fx-text-fill: white;">
                            <!-- Button for modify will be added dynamically -->
                        </TableColumn>
                        <TableColumn fx:id="supprimerCol" text="Supprimer" prefWidth="100" styleClass="action-column"
                                     style="-fx-background-color: rgba(10, 35, 66, 0.5); -fx-text-fill: white;">
                            <!-- Button for delete will be added dynamically -->
                        </TableColumn>
                    </columns>
                    <placeholder>
                        <VBox alignment="CENTER" spacing="10" styleClass="empty-placeholder">
                            <ImageView fitHeight="64.0" fitWidth="64.0" preserveRatio="true">
                                <image>
                                    <Image url="@icons/empty_list.png"/>
                                </image>
                            </ImageView>
                            <Label text="No users available" styleClass="empty-table-title-light"/>
                            <Label text="Search for users or add new ones." styleClass="empty-table-message-light"/>
                        </VBox>
                    </placeholder>
                </TableView>
                <BarChart fx:id="registrationBarChart" prefHeight="300" prefWidth="300"
                          title="User Registrations Over Time"
                          styleClass="chart-transparent"
                          style="-fx-background-color: rgba(10, 35, 66, 0.4); ">
                    <xAxis>
                        <CategoryAxis label="Month"   />
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Users"  />
                    </yAxis>
                </BarChart>

                <!-- Pagination
                <HBox alignment="CENTER" spacing="10" styleClass="pagination-container-transparent">
                    <Button styleClass="pagination-btn-transparent" text="&lt;"/>
                    <Pagination maxPageIndicatorCount="5" pageCount="10" styleClass="transparent-pagination" />
                    <Button styleClass="pagination-btn-transparent" text="&gt;"/>
                </HBox>-->

                <!-- Edit Form Section (initially hidden) -->
                <VBox fx:id="editForm" visible="false" spacing="15" styleClass="edit-form-transparent">
                    <padding>
                        <Insets top="15.0" right="20.0" bottom="15.0" left="20.0"/>
                    </padding>

                    <Text text="Edit User Information" styleClass="section-subtitle-light"/>

                    <GridPane hgap="15" vgap="15">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50" />
                            <ColumnConstraints percentWidth="50" />
                        </columnConstraints>

                        <TextField fx:id="nomField" promptText="Nom" styleClass="form-field-transparent"
                                   GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField fx:id="prenomField" promptText="Prénom" styleClass="form-field-transparent"
                                   GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <TextField fx:id="emailField" promptText="Email" styleClass="form-field-transparent"
                                   GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <TextField fx:id="telephoneField" promptText="Téléphone" styleClass="form-field-transparent"
                                   GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <TextField fx:id="dateNaissanceField" promptText="Date de Naissance" styleClass="form-field-transparent"
                                   GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <TextField fx:id="statutField" promptText="Statut" styleClass="form-field-transparent"
                                   GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <TextField fx:id="roleField" promptText="Role" styleClass="form-field-transparent"
                                   GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    </GridPane>

                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <Button text="Save Changes" onAction="#handleSaveChanges" styleClass="confirm-button">
                            <graphic>
                                <ImageView fitHeight="16.0" fitWidth="16.0" preserveRatio="true">
                                    <image>
                                        <Image url="@icons/save.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button text="Cancel" onAction="#handleCancelEdit" styleClass="cancel-button">
                            <graphic>
                                <ImageView fitHeight="16.0" fitWidth="16.0" preserveRatio="true">
                                    <image>
                                        <Image url="@icons/del.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </HBox>
                </VBox>

            </VBox>
        </center>
    </BorderPane>
</StackPane>